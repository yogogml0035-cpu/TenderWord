# Keep source and knowledge-pack diffs stable across Windows and WSL.
.gitattributes text eol=lf
.gitignore text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Office/PDF artifacts are binary and must not be normalized.
*.doc binary
*.docx binary
*.pdf binary
*.xlsx binary
