# ========================================
# TenderWord API 环境变量配置模板
# ========================================
# 复制此文件为 backend/.env 并填入实际值

# ========================================
# 应用基础配置
# ========================================
APP_NAME = "TenderWord API"
APP_VERSION = "1.0.0"
DEBUG = "false"
HOST = "0.0.0.0"
PORT = "8000"

# ========================================
# CORS 配置
# ========================================
CORS_ORIGINS = ["http://localhost:8502","http://127.0.0.1:8502","http://localhost:3000","http://127.0.0.1:3000"]

# ========================================
# 文件上传配置
# ========================================
UPLOAD_DIR = "D:/UploadFiles"
MAX_UPLOAD_SIZE = "104857600"
TEMPLATE_CANDIDATE_API_URL = "http://10.11.1.224/dongsong/servlet/tender.TenderJsonActionMb"
TENDER_DATA_API_URL = "http://dserp.dongsong-cn.com/dongsong//servlet/tender.TenderJsonAction"
TEMPLATE_CANDIDATE_ALLOWED_HOSTS = ["10.11.0.213","10.11.1.224"]
EXTERNAL_REQUEST_TIMEOUT_SECONDS = "15"

# ========================================
# LangSmith 配置（可选）
# ========================================
export LANGSMITH_TRACING=true
export LANGSMITH_ENDPOINT=https://api.smith.langchain.com
export LANGSMITH_API_KEY=<your-langsmith-api-key>
export LANGSMITH_PROJECT="DsAgent"

# ========================================
# LLM 提供商配置 - DeepSeek
# ========================================
LLM_STREAM_TIMEOUT_SECONDS = "20"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"
DEEPSEEK_API_KEY = ""
DEEPSEEK_MODEL = "deepseek-v4-flash"

# ========================================
# LLM 提供商配置 - Doubao (ARK)
# ========================================
ARK_BASE_URL = "https://ark.cn-beijing.volces.com/api/v3"
ARK_API_KEY = ""
DOUBAO_MODEL = "doubao-seed-1-6-251015"

# ========================================
# LLM 提供商配置 - Qwen (DashScope)
# ========================================
DASHSCOPE_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_API_KEY = ""
QWEN_MODEL = "qwen-plus"

# ========================================
# 批注坏案例混合检索测试配置
# ========================================
QDRANT_URL = "http://127.0.0.1:6333"
COMMENT_BAD_CASE_COLLECTION = "tenderword_comment_bad_cases_demo"
EMBEDDING_PROVIDER = "siliconflow"
SILICONFLOW_BASE_URL = "https://api.siliconflow.cn/v1"
EMBEDDING_BASE_URL = "https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY = ""
EMBEDDING_MODEL = "BAAI/bge-large-zh-v1.5"
EMBEDDING_DIMENSIONS = ""
