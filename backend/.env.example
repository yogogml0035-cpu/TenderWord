# ========================================
# TenderWord API 环境变量配置模板
# ========================================
# 复制此文件为 backend/.env 并填入实际值

# ========================================
# 应用基础配置
# ========================================
APP_NAME = "TenderWord API"
APP_VERSION = "1.0.0"
DEBUG = "false"
HOST = "0.0.0.0"
PORT = "8000"

# ========================================
# CORS 配置
# ========================================
CORS_ORIGINS = ["http://localhost:8502","http://127.0.0.1:8502","http://localhost:3000","http://127.0.0.1:3000"]

# ========================================
# 文件上传配置
# ========================================
UPLOAD_DIR = "D:/UploadFiles"
MAX_UPLOAD_SIZE = "104857600"
TEMPLATE_CANDIDATE_API_URL = "http://10.11.1.224/dongsong/servlet/tender.TenderJsonActionMb"
TEMPLATE_CANDIDATE_ALLOWED_HOSTS = ["10.11.0.213","10.11.1.224"]
EXTERNAL_REQUEST_TIMEOUT_SECONDS = "15"

# ========================================
# LangSmith 配置（可选）
# ========================================
LANGSMITH_TRACING = "false"

# ========================================
# LangFuse 配置（可选）
# ========================================
LANGFUSE_SECRET_KEY = ""
LANGFUSE_PUBLIC_KEY = ""
LANGFUSE_BASE_URL = ""

# ========================================
# LLM 提供商配置 - DeepSeek
# ========================================
DEEPSEEK_BASE_URL = "https://api.deepseek.com"
DEEPSEEK_API_KEY = ""
DEEPSEEK_MODEL = "deepseek-chat"

# ========================================
# LLM 提供商配置 - Doubao (ARK)
# ========================================
ARK_BASE_URL = "https://ark.cn-beijing.volces.com/api/v3"
ARK_API_KEY = ""
DOUBAO_MODEL = "doubao-seed-1-6-251015"

# ========================================
# LLM 提供商配置 - Qwen (DashScope)
# ========================================
DASHSCOPE_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_API_KEY = ""
QWEN_MODEL = "qwen-plus"
